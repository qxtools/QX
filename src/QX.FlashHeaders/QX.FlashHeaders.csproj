<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Qx.FlashHeaders</RootNamespace>
    <AssemblyName>QX.FlashHeaders</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QX.Core\QX.Core.csproj" />
    <ProjectReference Include="..\Flazzy\Flazzy.csproj" />
    <PackageReference Include="SharpCompress" Version="$(QxSharpCompressVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="signatures.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="signatures.json" LogicalName="Qx.FlashHeaders.signatures.json" />
  </ItemGroup>

</Project>
